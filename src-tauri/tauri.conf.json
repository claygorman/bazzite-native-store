{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bazzite-store",
  "mainBinaryName": "bazzite-store",
  "version": "0.13.0",
  "identifier": "com.claygorman.bazzite-store",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Bazzite Store",
        "width": 1920,
        "height": 1080,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/claygorman/bazzite-native-store/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERGQjkzN0Q1OEM3MDlGM0IKUldRN24zQ00xVGU1MzBJRFkvSnBuM1B1VHJ2R2VOYVhybVNGTGZvdTgrMjQ5NDFyNE8yZ0FLR3AK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
